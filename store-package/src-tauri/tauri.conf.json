{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鲸动交互平台",
  "version": "1.0.0",
  "identifier": "com.yangfeng.jingdong",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "鲸动交互平台 - 阳枫",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "阳枫",
    "copyright": "Copyright © 2026 阳枫. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
