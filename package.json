{
    "name": "react-example",
    "private": true,
    "overrides": {
        "proxy-addr": "2.0.8",
        "source-map-js": "1.2.2"
    },
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --port=3000 --host=0.0.0.0",
        "build": "vite build --config vite.export-player.config.ts && node tools/sync-export-player-runtime.mjs && vite build && node tools/sync-export-player-runtime.mjs && node tools/bundle-server.mjs",
        "build:store": "powershell -ExecutionPolicy Bypass -File ./store-package/build-store.ps1",
        "build:tauri": "powershell -ExecutionPolicy Bypass -File ./store-package/build-store.ps1",
        "build:exe": "powershell -ExecutionPolicy Bypass -File ./scripts/build-launcher.ps1",
        "preview": "vite preview",
        "clean": "rm -rf dist server.js",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:regression": "vitest run tests/commercial-readiness.test.ts tests/schema/normalize.test.ts tests/physicsHelper.test.ts",
        "test:release": "npm test && npm run lint && npm run build && npm audit --omit=dev",
        "test:watch": "vitest",
        "server": "node server/index.js",
        "dev:ai": "start \"AI3D-Proxy\" cmd /c \"node server/index.js\" && vite --port=3000 --host=0.0.0.0",
        "realtime:simulate": "node tools/realtime-mqtt-simulator.mjs",
        "realtime:load-test": "node tools/realtime-load-test.mjs",
        "realtime:backup": "node tools/realtime-backup.mjs",
        "cli": "node tools/aether-cli/cli.mjs",
        "mcp": "node tools/aether-cli/mcp.mjs",
        "runtime:fetch": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-node-runtime.ps1",
        "version:check": "node tools/check-version.mjs",
        "analyze": "node tools/analyze-build.mjs",
        "bundle:report": "node tools/report-bundle.mjs",
        "build:server": "node tools/bundle-server.mjs",
        "i18n:check": "tsx tools/check-i18n.mts",
        "check": "node tools/check-version.mjs && tsc --noEmit && vitest run && tsx tools/check-i18n.mts"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@mkkellogg/gaussian-splats-3d": "^0.4.7",
        "@tailwindcss/vite": "^4.1.14",
        "@types/jszip": "^3.4.1",
        "@types/qrcode": "^1.5.6",
        "@types/three": "^0.185.4",
        "@vitejs/plugin-react": "^5.0.4",
        "cannon-es": "^0.20.0",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "html2canvas-pro": "^2.4.5",
        "jszip": "^3.10.1",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "mp4-muxer": "^5.2.2",
        "mqtt": "^5.15.2",
        "qrcode": "^1.5.4",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "three": "^0.185.1",
        "vite": "^6.2.3",
        "webm-muxer": "^5.1.4",
        "zod": "^4.5.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@tauri-apps/cli": "^2.12.3",
        "@types/dom-webcodecs": "^0.1.19",
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/supertest": "^7.2.1",
        "autoprefixer": "^10.4.21",
        "esbuild": "^0.25.0",
        "mqtt-packet": "^9.0.2",
        "rollup-plugin-visualizer": "^7.1.1",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.3",
        "vitest": "^4.1.11"
    }
}
