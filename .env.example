# REALTIME_MQTT_URL="mqtt://127.0.0.1:1883"
# REALTIME_MQTT_TENANT_ID="tenant-demo"
# REALTIME_MQTT_SOURCE_ID="mqtt-demo"
# REALTIME_MQTT_TOPIC_PREFIX="aether"
# REALTIME_MQTT_USERNAME=""
# REALTIME_MQTT_PASSWORD=""
# REALTIME_MQTT_SECRET_REF="external-secret-store"
# REALTIME_DEVICE_DB_PATH="./data/realtime/device-events.sqlite"
# REALTIME_DEVICE_HISTORY_LIMIT="1000"
# REALTIME_ALERT_RULES_JSON="[{\"id\":\"high-temperature\",\"version\":1,\"name\":\"High temperature\",\"enabled\":true,\"condition\":{\"metric\":\"temperatureC\",\"operator\":\"gte\",\"value\":80},\"severity\":\"warning\",\"escalationAfterMs\":600000}]"
# Identity JWT role claim: viewer, operator, or admin. Production roles cannot be elevated by the token request body.
# REALTIME_BACKUP_DIR="./data/realtime/backups"
# REALTIME_LOAD_EVENTS="10000"
# REALTIME_LOAD_DEVICES="100"
