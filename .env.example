# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CORS_ORIGINS: comma-separated production frontend origins allowed to call server/index.js.
# Example: https://editor.example.com,https://staging-editor.example.com,http://tauri.localhost
# Include the packaged desktop origin when the Store app calls the API directly.
CORS_ORIGINS="https://editor.example.com,http://tauri.localhost,tauri://localhost"

# License redemption and export authorization. Required in production.
# Generate both values with a password manager or a cryptographically secure generator.
LICENSE_SECRET="replace-with-a-long-random-secret"
LICENSE_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
# Desktop builds must NOT issue licenses locally: the launcher starts node with
# AETHER_LICENSE_MODE=disabled, so /api/v1/license|export|checkout and the admin
# UI return 404 on the user's machine. Licensing lives on the website server.
AETHER_LICENSE_MODE="local"
# Only for local development. Never enable on a machine you distribute.
AETHER_ALLOW_DEV_LICENSE="0"
# Admin endpoints are loopback-only unless this is explicitly set.
AETHER_ALLOW_REMOTE_ADMIN="0"
LICENSE_DATA_PATH="./data/licenses.json"
# The current JSON file adapter is single-process. Keep false until a real shared DB/Redis adapter is implemented.
LICENSE_MULTI_INSTANCE="false"
LICENSE_ADMIN_SESSION_TTL_MS="28800000"
LICENSE_TOKEN_TTL_MS="43200000"
LICENSE_EXPORT_TOKEN_TTL_MS="300000"
# Frontend license endpoint. Defaults to same-origin in dev and
# https://jd-hub.top in production builds unless overridden at build time.
# VITE_API_BASE_URL="https://jd-hub.top"

# P2 realtime BFF. Upstream credentials stay only on the server and are never exported.
# VITE_REALTIME_SOURCE_ID="mqtt-demo"  # 编辑器 MQTT 实时绑定使用的服务端 sourceId；开发演示默认 demo-rest
# REALTIME_REST_URL="https://telemetry.example.com/api/v1/snapshot"
# REALTIME_REST_BEARER="server-only-upstream-token"
# REALTIME_TOKEN_SECRET="replace-in-production"
# REALTIME_IDENTITY_SECRET="shared-secret-for-trusted-identity-jwt"
# REALTIME_TOKEN_TTL_MS="300000"
# REALTIME_MAX_CLIENTS="100"
